# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/ai_freelance?schema=public"

# --- Auth ---
# 32+ character random string. openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Gemini ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
